# Copy this file to `.env` and add your real GROQ_API_KEY locally.
# Do NOT commit `.env` — it's ignored by .gitignore.

# Get an API key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CORRECTION_MODEL=llama-3.3-70b-versatile
GROQ_CONVERSATION_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah

# Comma-separated list of origins allowed to call this API (dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
